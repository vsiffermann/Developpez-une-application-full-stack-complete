{
  "info": {
    "name": "MDD — Monde de Dév",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.com\",\n  \"username\": \"testuser\",\n  \"password\": \"Test1234!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"test@test.com\",\n  \"password\": \"Test1234!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Utilisateur",
      "item": [
        {
          "name": "Mon profil",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Modifier mon profil",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nouveau@test.com\",\n  \"username\": \"nouveaunom\",\n  \"password\": \"NewPass1!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Thèmes",
      "item": [
        {
          "name": "Liste des thèmes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/topics",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "S'abonner à un thème",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/topics/1/subscribe",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Se désabonner d'un thème",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/topics/1/subscribe",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Articles",
      "item": [
        {
          "name": "Fil d'actualité (desc)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts/feed?sort=desc",
              "query": [{ "key": "sort", "value": "desc" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Fil d'actualité (asc)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts/feed?sort=asc",
              "query": [{ "key": "sort", "value": "asc" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Créer un article",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/posts",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicId\": 1,\n  \"title\": \"Mon premier article\",\n  \"content\": \"Contenu de l'article...\"\n}"
            }
          }
        },
        {
          "name": "Consulter un article",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Ajouter un commentaire",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/posts/1/comments",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Mon commentaire...\"\n}"
            }
          }
        }
      ]
    }
  ]
}
